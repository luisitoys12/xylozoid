# ==========================================
# CONFIGURACIÓN DE LICENCIA - XYLOZOID
# ==========================================
# Para el dueño del proyecto, usa: OWNER
# Para beta testers, usa cualquier clave (se valida en modo desarrollo)
# Para producción, necesitas una licencia válida del servidor
XYLOZOID_LICENSE_KEY=OWNER

# Entorno: development o production
# En development, las licencias se simulan como válidas
NODE_ENV=development

# URL del servidor de licencias (solo para producción)
# LICENSE_SERVER_URL=https://api.xylozoid.dev/licenses

# Token de Ngrok para túnel 24/7 (opcional, solo si usas ngrok)
NGROK_AUTHTOKEN=